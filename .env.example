# Required: your MongoDB connection string (Atlas or local) and database name.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=wuthering_waves
# Tip: put a different MONGODB_DB (for example wuthering_waves_dev) in .env.development.local so "npm run dev" uses its own database,
# and the production name in .env.production.local. Fill the dev database with "npm run db:copy-dev".

# Discord bots, both started from the dashboard. Leave a token empty to disable that bot.
DISCORD_TOKEN_TEST=
# Optional: a test server ID registers slash commands there instantly.
DISCORD_GUILD_ID_TEST=
DISCORD_TOKEN_LIVE=
DISCORD_GUILD_ID_LIVE=

# Image uploads to the asset repository (optional).
# Fine-grained GitHub token with "Contents: Read and write" on that repository only.
GITHUB_TOKEN=
GITHUB_REPO=krulciferikaru/Database
GITHUB_BRANCH=main

# Optional: set these only if the bot's application id cannot be worked out from its token (needed for emoji management).
DISCORD_CLIENT_ID_TEST=
DISCORD_CLIENT_ID_LIVE=
